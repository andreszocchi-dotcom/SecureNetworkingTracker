# Copy to .env.local and fill in real values. .env.local is gitignored and must never be committed.
#
#   cp .env.example .env.local
#
# Values come from the Neon Console: the Auth tab, the Data API tab, and the connection string on
# the project dashboard.

# ---------------------------------------------------------------------------
# Public — shipped in the browser bundle, and meant to be. These are HTTPS endpoints, not
# credentials. The frontend uses them to sign users in and to read contacts from the Data API.
# Row Level Security is what protects the rows behind them; see db/schema.sql.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_NEON_AUTH_URL=https://ep-example-123456.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEXT_PUBLIC_NEON_DATA_API_URL=https://ep-example-123456.apirest.us-east-1.aws.neon.tech/neondb/rest/v1

# ---------------------------------------------------------------------------
# Server-only — no NEXT_PUBLIC_ prefix, so Next.js never inlines these into the browser bundle.
# ---------------------------------------------------------------------------

# The backend fetches Managed Better Auth's public JWKS from here to verify the caller's JWT
# before performing a write. Keeping it server-side means a client cannot point the backend at
# a key set of its own choosing.
NEON_AUTH_BASE_URL=https://ep-example-123456.neonauth.us-east-1.aws.neon.tech/neondb/auth

# Used ONLY by db/apply.mjs, run from a developer machine to create the table and RLS policies.
# The deployed application never reads this, and it is NOT set in Vercel.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Not used by this implementation.
#
# NEON_AUTH_COOKIE_SECRET signs an app-managed session cookie. This app does not manage one: the
# browser holds its Better Auth session and forwards a short-lived JWT to the backend, which
# verifies it against the JWKS above. Listed here so it is clear the omission is deliberate.
# If you add cookie-based server sessions, generate one with: openssl rand -base64 32
# ---------------------------------------------------------------------------

# NEON_AUTH_COOKIE_SECRET=replace-with-a-random-string-of-at-least-32-characters

# ---------------------------------------------------------------------------
# Local test and evidence tooling only. Not needed to run the app.
# ---------------------------------------------------------------------------

# Two throwaway accounts used by `npm run test:rls` and the Playwright evidence capture to prove
# that User A cannot read or change User B's contacts.
TEST_USER_A_EMAIL=test-a@example.com
TEST_USER_A_PASSWORD=replace-with-a-test-password
TEST_USER_B_EMAIL=test-b@example.com
TEST_USER_B_PASSWORD=replace-with-a-test-password

# Target for the Playwright evidence run. Defaults to http://localhost:3000.
E2E_BASE_URL=https://your-app.vercel.app
